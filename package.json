{
  "name": "n8n-nodes-tandoor",
  "version": "0.1.0",
  "description": "n8n node for Tandoor Recipes: manage recipes, meal plans, foods, units, keywords and the shopping list",
  "keywords": [
    "n8n-community-node-package",
    "n8n-node-tandoor",
    "tandoor",
    "recipes",
    "meal-planning",
    "cooking",
    "shopping-list"
  ],
  "license": "MIT",
  "homepage": "https://github.com/phbreyzon/n8n-nodes-tandoor#readme",
  "author": {
    "name": "phbreyzon",
    "email": "phbreyzon@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phbreyzon/n8n-nodes-tandoor.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials",
    "lintfix": "eslint nodes credentials --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TandoorApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Tandoor/Tandoor.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "typescript-eslint": "^8.44.1",
    "gulp": "^5.0.1",
    "n8n-workflow": "^1.110.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
